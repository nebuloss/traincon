{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // ESM rather than the CommonJS used by the React apps here: this server
    // relies on import.meta.url and top-level await throughout.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist-server",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    // Imports are written with .ts extensions and rewritten to .js on emit,
    // so the same specifier works in the editor and in the built output.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/server", "src/shared"]
}
