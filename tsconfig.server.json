{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // ESM rather than the CommonJS used by the React apps here: this server
    // relies on import.meta.url and top-level await throughout.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist-server",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/server", "src/shared"]
}
